{{ 'sliding-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-image-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'image-marquee.js' | asset_url }}" defer="defer"></script>

<section id="slidingImageBanner-{{ section.id }}" class="sliding-image-banner">
  <div class="page-width">
    {% render 'image-marquee',
      image_prefix: 'sliding-banner-image',
      image_count: 5,
      seconds_per_image: 10,
      image_width: 900,
      image_height: 500
    %}
  </div>
</section>

{% schema %}
{
    "name": "Sliding-Image-Banner",
    "settings": [],
    "presets": [
        {
            "name": "Sliding-Image-Banner"
        }
    ]
}
{% endschema %}
